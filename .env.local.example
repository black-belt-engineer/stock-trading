# Copy to `.env.local` and customize (`.env.local` is gitignored).
# Use `docker compose --env-file .env.local up -d` so Compose interpolates variables here.

# --- Kafka (Redpanda in docker-compose; apps on host use localhost) ---
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=stock-prices
# apps/consumer
KAFKA_GROUP_ID=stock-prices-consumer
KAFKA_CLIENT_ID=ingestor
KAFKA_TOPIC_PARTITIONS=6
KAFKA_REPLICATION_FACTOR=1

# --- Redis ---
# From host:
REDIS_URL=redis://localhost:6379
# From another container on stock-net, use instead:
# REDIS_URL=redis://redis:6379

# --- Postgres ---
# From host:
DATABASE_URL=postgresql://stockuser:stockpass@localhost:5432/stockdb
# From another container on stock-net, use instead:
# DATABASE_URL=postgresql://stockuser:stockpass@postgres:5432/stockdb

# --- Keycloak (docker-compose, http://localhost:8180) ---
# Bootstrap admin for the admin console; compose defaults to admin/admin when unset.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
# Secret of the confidential client stock-bff, shared by Keycloak (realm import) and apps/bff.
# scripts/dev.sh generates one into .env.local; never commit a real value. Changing it needs
# `scripts/dev.sh --reset-realm`, because Keycloak only imports the realm once.
# KC_BFF_CLIENT_SECRET=<43 base64url characters>
# "Continue with Google" (optional). Without both values the provider stays disabled and the
# login and register pages show no Google button. Create the client in Google Cloud console:
# APIs & Services > Credentials > Create credentials > OAuth client ID > "Web application",
# authorised redirect URI http://localhost:5173/realms/stock-platform/broker/google/endpoint
# (it follows KC_HOSTNAME, not port 8180). While the consent screen is in "Testing" mode, only
# listed test users can sign in. Changing either value needs `scripts/dev.sh --reset-realm`.
# GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=<secret>

# --- apps/auth ---
USER_SERVICE_URL=http://localhost:3004
# ES256 private key (PKCS8 PEM, newlines as \n). Generate with: pnpm --filter @stock-platform/auth keys:generate
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Short-lived access token; logout revokes the refresh token, not already-issued access tokens.
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=604800
# Must match between apps/auth, apps/user and apps/sse-service (defaults shown).
JWT_ISSUER=stock-auth
JWT_AUDIENCE=stock-platform

# --- apps/user + apps/sse-service ---
# Where the JWT guard fetches the public keys (/.well-known/jwks.json).
AUTH_SERVICE_URL=http://localhost:3005

# --- apps/auth + apps/user ---
# Shared secret for internal calls between the two services (sent as X-Internal-Token).
# At least 32 characters. scripts/dev.sh generates one into .env.local; never commit a real value.
# INTERNAL_API_TOKEN=<64 hex characters>

# --- apps/auth + apps/user: client IP for the rate limits ---
# Proxies whose X-Forwarded-For is trusted (Fastify trustProxy): IP/CIDR or proxy-addr names,
# comma separated. `loopback` trusts the Vite dev proxy. Empty trusts no proxy (socket address).
# In production, set it to the reverse proxy's address (README Q9).
TRUST_PROXY=loopback
