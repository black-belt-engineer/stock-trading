# Copy to `.env.local` and customize (`.env.local` is gitignored).
# Use `docker compose --env-file .env.local up -d` so Compose interpolates variables here.

# --- Kafka (Redpanda in docker-compose; apps on host use localhost) ---
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=stock-prices
# apps/consumer
KAFKA_GROUP_ID=stock-prices-consumer
KAFKA_CLIENT_ID=ingestor
KAFKA_TOPIC_PARTITIONS=6
KAFKA_REPLICATION_FACTOR=1

# --- Redis ---
# From host:
REDIS_URL=redis://localhost:6379
# From another container on stock-net, use instead:
# REDIS_URL=redis://redis:6379

# --- Postgres ---
# From host:
DATABASE_URL=postgresql://stockuser:stockpass@localhost:5432/stockdb
# From another container on stock-net, use instead:
# DATABASE_URL=postgresql://stockuser:stockpass@postgres:5432/stockdb

# --- apps/auth ---
USER_SERVICE_URL=http://localhost:3004
# ES256 private key (PKCS8 PEM, newlines as \n). Generate with: pnpm --filter @stock-platform/auth keys:generate
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Short-lived access token; logout revokes the refresh token, not already-issued access tokens.
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=604800
# Must match between apps/auth and apps/user (defaults shown).
JWT_ISSUER=stock-auth
JWT_AUDIENCE=stock-platform

# --- apps/user ---
AUTH_SERVICE_URL=http://localhost:3005
