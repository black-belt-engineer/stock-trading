{
  "name": "stock-trading",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "build-keycloak-theme": "turbo run build-keycloak-theme --filter=@stock-platform/keycloak-theme",
    "theme:storybook": "pnpm --filter @stock-platform/keycloak-theme run storybook",
    "dev": "turbo run dev",
    "dev:all": "bash scripts/dev.sh",
    "dev:setup": "bash scripts/dev.sh --setup-only",
    "dev:down": "bash scripts/dev.sh --down",
    "lint": "turbo run lint",
    "docs:api": "node scripts/api-docs.mjs"
  },
  "devDependencies": {
    "turbo": "^2.9.8"
  }
}
